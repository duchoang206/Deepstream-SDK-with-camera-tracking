# Web Dashboard Environment Configuration Template

# Backend FastAPI REST & WebSocket endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/events

# MediaMTX WebRTC (WHEP) Streaming Server
NEXT_PUBLIC_MEDIAMTX_WEBRTC_URL=http://localhost:8889

# DeepStream RTSP Stream Names
