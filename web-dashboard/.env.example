NEXT_PUBLIC_CAM3_NAME=Camera 3 - Loading Dock
NEXT_PUBLIC_CAM4_NAME=Camera 4 - Perimeter East

# Application Settings
NEXT_PUBLIC_APP_NAME="DeepStream Multi-Camera Analytics"
NEXT_PUBLIC_ENABLE_MOCK_FEED=false
